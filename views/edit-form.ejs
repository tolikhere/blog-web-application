<%- include('./partials/header') %>

<h2>Edit Post: <%= post.title %></h2>

<form id="edit-form" class="post-form" action="/edit/<%= post.id %>" method="POST">
  <div class="form-group">
    <label class="form-label" for="title">Title</label>
    <input class="form-control" id="title" type="text" name="title" value="<%= post.title %>" required>
    <label class="form-label" for="message">Post Content</label>
    <textarea class="form-control" id="content" name="message" required cols="30" rows="5"><%= post.message %></textarea>
  </div>
  <div class="post-actions">
      <a href="/#<%= post.id %>">
        <button type="button" class="btn delete-btn">Cancel</button>
      </a>
      <button id="save-btn" type="submit" class="btn save-btn">Save</button>
    </div>
</form>

<%- include('./partials/footer') %>
