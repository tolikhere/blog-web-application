<%- include('./partials/header') %>

<form id="post-form" class="post-form" action="/new-post" method="POST">
  <div class="form-group">
    <label class="form-label" for="title">Title</label>
    <input class="form-control" required type="text" id="title" name="title" value="" />
    <label class="form-label" for="content">Post Content</label>
    <textarea class="form-control" name="message" id="content" cols="30" rows="5"></textarea>
  </div>
  <button id="post-btn" class="btn submit-btn" type="submit">
    Add Post
  </button>
</form>
<hr>
<h2>All Posts</h2>
<section class="post-container">
<% posts.forEach(function(post) { %>
  <article id="<%= post.id %>" class="post-item">
    <div class="post-content">
      <h3><%= post.title %></h3>
      <hr>
      <p><%= post.message %></p>
      <hr>
    </div>
    <div class="post-actions">
      <!-- Link to delete this specific post ID -->
      <a href="/delete/<%= post.id %>">
        <button class="btn delete-btn">Delete</button>
      </a>
      <!-- Link to the edit page for this specific post ID -->
      <a href="/edit/<%= post.id %>">
        <button class="btn edit-btn">Edit</button>
      </a>
    </div>
  </article>
<% }); %>
</section>
<%- include('./partials/footer') %>
